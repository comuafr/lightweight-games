<?xml version="1.0" encoding="utf-8"?>
<!-- Help texts are looked up by name (rules_<gameId>, controls_<gameId>) in ui/HelpView.kt,
     so the resource shrinker cannot see they are used and would strip them from release builds. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/rules_*,@string/controls_*" />
